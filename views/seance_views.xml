<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_formation_seance_tree" model="ir.ui.view">
        <field name="name">formation.seance.tree</field>
        <field name="model">formation.seance</field>
        <field name="arch" type="xml">
            <tree string="Séances">
                <field name="session_id"/>
                <field name="date_day"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
            </tree>
        </field>
    </record>

    <record id="view_formation_seance_form" model="ir.ui.view">
        <field name="name">formation.seance.form</field>
        <field name="model">formation.seance</field>
        <field name="arch" type="xml">
            <form string="Séance">
                <sheet>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="date_day"/>
                        </group>
                        <group>
                            <field name="room_id"/>
                            <field name="start_hour"  widget="float_time"/>
                            <field name="end_hour" widget="float_time"/>
                        </group>
                    </group>

                    <notebook>
                      <page string="Appel / Présences">
                        <field name="attendance_ids">
                            <tree editable="bottom">
                                <field name="partner_id"/>
                                <field name="attendance_status"/>
                            </tree>
                        </field>
                      </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_formation_seance" model="ir.actions.act_window">
        <field name="name">Séances</field>
        <field name="res_model">formation.seance</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première séance de formation !
            </p>
        </field>
    </record>




    </odoo>