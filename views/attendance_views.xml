<?xml version="1.0" encoding="utf-8"?>
<odoo>


<record id="view_formation_attendance_tree" model="ir.ui.view">
    <field name="name">formation.attendance.tree</field>
    <field name="model">formation.attendance</field>
    <field name="arch" type="xml">
        <tree editable="bottom">
            <field name="date_day" readonly="1"/>
            <field name="seance_id"/>
            <field name="registration_id"/>
            <field name="partner_id" readonly="1"/>
            <field name="attendance_status" widget="radio" options="{'horizontal': true}"/>
        </tree>
    </field>
</record>

<record id="action_formation_attendance" model="ir.actions.act_window">
        <field name="name">Feuilles de Présence</field>
        <field name="res_model">formation.attendance</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Gérez les présences des étudiants ici.
            </p>
        </field>
    </record>

</odoo>