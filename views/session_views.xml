<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_session_tree" model="ir.ui.view">
        <field name="name">formation.session.tree</field>
        <field name="model">formation.session</field>
        <field name="arch" type="xml">

         
            <tree string="Sessions" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'">

                <field name="name"/>
                <field name="instructor_eligible_ids" invisible="1"/>
                <field name="course_id"/>
                <field name="instructor_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="seats"/>
                
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-success="state == 'confirmed'" 
                       decoration-muted="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_session_form" model="ir.ui.view">
        <field name="name">formation.session.form</field>
        <field name="model">formation.session</field>
        <field name="arch" type="xml">
            <form string="Session">
                    <header>
                        <button name="action_confirm" string="Confirmer" type="object" class="oe_highlight" 
                                invisible="state not in ['draft', 'postponed']"/>
                        
                        <button name="action_notify_missing_evaluations" 
                        string="Vérifier Évaluations" 
                        type="object" 
                        class="oe_link" 
                        invisible="state != 'done'"/>

                        <button name="action_in_progress" string="Démarrer la formation" type="object" class="oe_highlight" 
                                invisible="state != 'confirmed'"/>

                        <button name="action_done" string="Terminer la session" type="object" class="oe_highlight" 
                                invisible="state != 'in_progress'"/>

                        <button name="action_postpone" string="Reporter" type="object" 
                                invisible="state not in ['draft', 'confirmed', 'in_progress']"/>

                        <button name="action_cancel" string="Annuler" type="object" 
                                invisible="state in ['done', 'cancelled']"/>

                        <button name="action_draft" string="Remettre en brouillon" type="object" 
                                invisible="state not in ['cancelled', 'postponed']"/>

                        <field name="state" widget="statusbar" 
                            statusbar_visible="draft,confirmed,in_progress,done"/>
                    </header>
                    <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Ex: Session Data Mining Mars 2026"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="course_id"/>
                            <field name="instructor_eligible_ids" invisible="1"/>
                            <field name="instructor_id"/>
                            <field name="duration_total" widget="float_time" readonly="1"/>
                            
                            
                        </group>

                        <group string="Calendrier &amp; Logistique">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="seats"/>
                           
                        </group>
                    </group>

                    <notebook>
                        <page string="Séances de cours" name="seances">
                            <field name="seance_ids">
                                <tree string="Liste des séances">
                                    <field name="date_day"/>
                                    <field name="start_hour" widget="float_time"/>
                                    <field name="end_hour" widget="float_time"/>
                                    <field name="room_id"/> 
                                    
                                </tree>

                                <form string="Détail de la Séance">
                                    <sheet>
                                        <group>
                                            <group string="Informations Générales">
                                                <field name="date_day"/>
                                                <field name="unavailable_room_ids" invisible="1"/>
                                                <field name="room_id" 
                                                    domain="[('id', 'not in', unavailable_room_ids), ('state', '=', 'available')]"
                                                    options="{'no_create': True, 'no_open': True}"/>
                                            </group>
                                            <group string="Horaires &amp; Analyse">
                                                <field name="start_hour" widget="float_time"/>
                                                <field name="end_hour" widget="float_time"/>
                                                <field name="occupation_percent" widget="progressbar"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Présences">
                                                <field name="attendance_ids">
                                                    <tree editable="bottom">
                                                        <field name="partner_id"/>
                                                        <field name="attendance_status"/>
                                                    </tree>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <page string="Salles Utilisées">
                            <field name="room_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="location"/>
                                    <field name="capacity"/> </tree>
                            </field>
                        </page>
                        <page string="Participants">
                           
                            <field name="registration_ids">
                                <tree>
                                    <field name="partner_id"/>
                                    <field name="evaluation"/>
                                    <field name="status" widget="badge" 
                                        decoration-success="status == 'registered'" 
                                        decoration-danger="status == 'cancelled'"/>
                                    <button name="action_print_certificate" string="Imprimer Attestation" 
                                            type="object" icon="fa-print"
                                            invisible="parent.state != 'done' or status != 'completed'"/>
                                    <button name="action_view_attendance" string="Détails Présences" 
                                            type="object" icon="fa-calendar"/>
                                </tree>
                            </field>
                        </page>

                                  
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_formation_session" model="ir.actions.act_window">
        <field name="name">Sessions de Formation</field>
        <field name="res_model">formation.session</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première session de formation au CETIC !
            </p>
        </field>
    </record>


    

</odoo>