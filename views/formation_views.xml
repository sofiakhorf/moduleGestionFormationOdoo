<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_formation_course_tree" model="ir.ui.view">
        <field name="name">formation.course.tree</field>
        <field name="model">formation.course</field>
        <field name="arch" type="xml">
            <tree string="Formations">
                <field name="name"/>
                <field name="level"/>
                <field name="duration"/>
            </tree>
        </field>
    </record>

    <record id="view_formation_course_form" model="ir.ui.view">
        <field name="name">formation.course.form</field>
        <field name="model">formation.course</field>
        <field name="arch" type="xml">
            <form string="Formation">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="level"/>
                        </group>
                        <group>
                            <field name="duration"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Formateurs habilités">
                            <field name="instructor_ids" context="{'default_is_instructor': 1}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="diploma"/>
                                    <field name="expertise"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_formation_course" model="ir.actions.act_window">
        <field name="name">Cours de Formation</field>
        <field name="res_model">formation.course</field>
        <field name="view_mode">tree,form</field>
    </record>

    


</odoo>